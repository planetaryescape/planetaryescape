---
const services = [
  // {
  //   title: "Industries",
  //   description: "E-Commerce, Finance, Music"
  // },
  {
    title: "Web Development",
    description:
      "Collectively, this is our core area of expertise.",
  },
  {
    title: "Mobile Apps",
    description:
      "iOS & Android.",
  },
  {
    title: "Servers & Backend",
    description:
      "Done cost effectively.",
  },
  {
    title: "General Consulting",
    // subtitle: "The little details",
    description: "The minutiae that bring your software project to life. We've worked on projects of all sizes, it's become second nature to spot how to make things work.",
  },
];
---

<section class="border-b border-white/20">
  <div class="mx-auto border-white/20 border-x max-w-7xl">
    <div class="p-8">
      <p class="text-3xl uppercase font-display lg:text-6xl">
        our services; Explained
      </p>
    </div>
    <div class="grid grid-cols-1 gap-px p-8 mx-auto sm:grid-cols-2 md:grid-cols-4 bg-white/20">
      {
        services.map((service) => (
          <div class="flex flex-col gap-3 p-6 bg-black transition-colors duration-200 hover:bg-charcoal sm:p-8">
            <h2 class="text-xl font-medium font-display uppercase">{service.title}</h2>
            <p class="text-sm text-eagle sm:text-base">{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
