---
const projects = [
  {
    name: "LifeCoachOS",
    href: "https://life-coach-os-web.vercel.app",
    description: "A coaching platform built to support daily planning, reflection, and personal progress.",
  },
  {
    name: "spotuify",
    href: "https://github.com/planetaryescape/spotuify",
    external: true,
    description: "A keyboard-native TUI, scriptable CLI, and desktop Mac app for Spotify, all backed by the same daemon.",
  },
  {
    name: "mxr",
    href: "https://mxr-mail.vercel.app",
    description: "Local-first, keyboard-native terminal email client.",
  },
  {
    name: "videoshare",
    href: "https://github.com/planetaryescape/videoshare",
    external: true,
    description: "Share videos with clients and friends through a clean, simple player.",
  },
  {
    name: "blah.chat",
    href: "https://blah.chat",
    description: "All AI models in one chat, with a self-hostable cloud version.",
  },
  {
    name: "opensound",
    href: "https://opensound.dev/",
    description: "Tooling for your music library.",
  },
  {
    name: "goosebumps.fm",
    href: "https://goosebumps.fm",
    description: "Making it easier to share curated music with friends.",
  },
];
---

<section class="border-b border-white/20">
  <div class="mx-auto border-white/20 border-x max-w-7xl">
    <div class="p-8">
      <p class="text-3xl uppercase font-display lg:text-6xl">
        Some Projects We've Worked On
      </p>
    </div>
    <div class="border-t border-white/20">
      {
        projects.map((project, i) => (
          <a
            href={project.href}
            target={project.external ? "_blank" : undefined}
            rel={project.external ? "noopener noreferrer" : undefined}
            class="group relative flex flex-col gap-2 border-b border-white/20 px-8 py-6 no-underline transition-colors duration-200 hover:bg-charcoal sm:flex-row sm:items-baseline sm:gap-8 sm:py-8"
          >
            <span class="font-display text-sm text-eagle transition-colors duration-200 group-hover:text-orange sm:w-12 sm:shrink-0">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="font-display text-xl uppercase transition-colors duration-200 group-hover:text-orange sm:w-64 sm:shrink-0 lg:text-2xl">
              {project.name}
            </span>
            <span class="text-sm text-eagle sm:pr-12 sm:text-base">
              {project.description}
            </span>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute right-8 top-1/2 -translate-y-1/2 -translate-x-2 text-orange opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100"
            >
              &#8594;
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
