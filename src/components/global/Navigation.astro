---
const homePage = Astro.url.origin;
const isDiscordPage = Astro.url.pathname === '/discord';
---

<nav
  class="justify-center w-full mx-auto bg-black border-t border-b border-white/20 2xl:max-w-7xl lg:sticky lg:top-0 lg:z-50">
  <div class="justify-center w-full mx-auto bg-black">
    <div
      class="flex flex-col w-full mx-auto border-white/20 border-x max-w-7xl lg:flex-row lg:items-center lg:justify-between">
      <div
        class="flex flex-col items-stretch justify-between w-full text-center md:px-0 sm:flex-row sm:px-8">
        <a
          href={homePage}
          class="inline-flex items-center p-4 text-xs uppercase font-display md:text-center hover:bg-white h-full"
          >
          <img src="/logo.svg" alt="Planetary Escape" class="h-6 w-auto" />
        </a>
        <div class="flex items-center">
          <a
            href="/opensauce"
            class="px-6 py-4 h-full text-xs text-center text-white uppercase duration-200 border-white/20 border-l font-display flex items-center justify-center hover:bg-white hover:text-black"
          >
            Open Source
          </a>
          <a
            href="https://github.com/planetaryescape"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-4 h-full text-xs text-center text-white uppercase duration-200 border-white/20 border-l font-display flex items-center justify-center gap-2 hover:bg-white hover:text-black"
          >
            <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.58.1.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.41-5.27 5.69.42.36.78 1.07.78 2.16 0 1.56-.01 2.82-.01 3.2 0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
            </svg>
            GitHub
          </a>
          <a
            href={isDiscordPage ? "https://discord.gg/pFvKSmzWpH" : "/discord"}
            class="w-full px-6 py-4 h-full text-xs text-center text-black uppercase duration-200 bg-white font-display lg:w-auto flex items-center justify-center gap-2"
          >
            <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="currentColor" aria-hidden="true">
              <path d="M20.32 5.36a19.8 19.8 0 0 0-4.9-1.52.07.07 0 0 0-.08.04c-.21.38-.45.87-.61 1.26a18.3 18.3 0 0 0-5.48 0 12.6 12.6 0 0 0-.62-1.26.08.08 0 0 0-.08-.04c-1.71.3-3.35.82-4.9 1.52a.07.07 0 0 0-.03.03C1.02 9.1.36 12.72.68 16.3a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 5.02 2.53.08.08 0 0 0 .09-.03c.39-.53.73-1.09 1.03-1.68a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1-.01-.13c.13-.09.25-.19.37-.29a.08.08 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.08.08 0 0 1 .08.01c.12.1.24.2.37.29a.08.08 0 0 1-.01.13c-.6.35-1.22.65-1.87.89a.08.08 0 0 0-.04.11c.31.59.65 1.15 1.03 1.68a.08.08 0 0 0 .09.03 19.83 19.83 0 0 0 5.02-2.53.08.08 0 0 0 .03-.06c.38-4.14-.64-7.72-2.7-10.91a.06.06 0 0 0-.03-.03ZM8.68 14.1c-.9 0-1.64-.83-1.64-1.85 0-1.02.72-1.85 1.64-1.85.93 0 1.66.84 1.64 1.85 0 1.02-.72 1.85-1.64 1.85Zm6.65 0c-.9 0-1.64-.83-1.64-1.85 0-1.02.72-1.85 1.64-1.85.93 0 1.66.84 1.64 1.85 0 1.02-.71 1.85-1.64 1.85Z" />
            </svg>
            {isDiscordPage ? "Join The Discord Server" : "Discord Community"}
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>
