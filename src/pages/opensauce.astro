---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="border-b border-white/20">
    <div class="mx-auto border-white/20 border-x max-w-7xl">
      <div class="p-8">
        <p class="text-3xl uppercase font-display lg:text-6xl">
          Some open source projects that may be of interest
        </p>
        <p class="max-w-3xl mt-6 text-eagle">
          A small collection of tools we've built and shipped publicly. Most are
          built with Effect, Rust, or Go. The code is open, the design is
          opinionated, and the goal is always the same: make the thing work
          without getting in the way.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-white/20">
    <div class="mx-auto border-white/20 border-x max-w-7xl p-4 sm:p-6">
      <div class="grid grid-cols-1 sm:grid-cols-4 lg:grid-cols-6 auto-rows-[minmax(0,1fr)] gap-4">
        <article
          class="group relative sm:col-span-4 sm:row-span-2 lg:col-span-4 p-8 lg:p-10 border border-white/20 bg-black transition-colors duration-200 hover:border-orange/60 focus-within:border-orange/60 sm:-rotate-[0.4deg]"
        >
          <div class="flex flex-wrap items-center gap-3">
            <a
              href="https://github.com/planetaryescape/spotuify"
              target="_blank"
              rel="noopener noreferrer"
              class="text-3xl lg:text-5xl uppercase font-display hover:text-orange duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange focus-visible:outline-offset-4"
              >Spotuify</a
            >
            <span class="px-2 py-0.5 text-[10px] uppercase font-display border border-orange text-orange rotate-2">
              Featured
            </span>
          </div>
          <p class="mt-4 max-w-xl text-eagle">
            A keyboard-native TUI and a fully scriptable CLI for Spotify. Search,
            play, queue, switch devices, build playlists, read synced lyrics,
            see album art, all without leaving the shell. Ships with a native
            macOS menu bar app.
          </p>
          <div class="flex flex-wrap gap-2 mt-6 text-[10px] uppercase font-display">
            <span class="px-2 py-0.5 border border-white/20">Rust</span>
            <span class="px-2 py-0.5 border border-white/20 -translate-y-0.5">Swift</span>
            <span class="px-2 py-0.5 border border-white/20">Spotify API</span>
            <span class="px-2 py-0.5 border border-white/20 translate-y-0.5">TUI</span>
          </div>
          <div class="mt-6">
            <a
              href="https://github.com/planetaryescape/spotuify"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-4 text-xs uppercase font-display border border-white hover:bg-white hover:text-black duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange focus-visible:outline-offset-4"
              >View on GitHub →</a
            >
          </div>
        </article>

        <article
          class="sm:col-span-2 lg:col-span-2 p-6 border border-white/20 bg-black transition-colors duration-200 hover:border-orange/60 focus-within:border-orange/60 flex flex-col justify-between"
        >
          <div>
            <a
              href="https://github.com/planetaryescape/mxr"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xl uppercase font-display hover:text-orange duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange focus-visible:outline-offset-4"
              >mxr</a
            >
            <p class="mt-3 text-sm text-eagle">
              Local-first, keyboard-native terminal email client, written in Rust.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 mt-4 text-[10px] uppercase font-display">
            <span class="px-2 py-0.5 border border-white/20">Rust</span>
          </div>
        </article>

        <article
          class="sm:col-span-2 lg:col-span-2 p-6 border border-white/20 bg-black transition-colors duration-200 hover:border-orange/60 focus-within:border-orange/60 flex flex-col justify-between lg:translate-y-2"
        >
          <div>
            <a
              href="https://github.com/planetaryescape/pulse"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xl uppercase font-display hover:text-orange duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange focus-visible:outline-offset-4"
              >pulse</a
            >
            <p class="mt-3 text-sm text-eagle">
              CLI that recursively scans directories for git repos and prints a
              status summary. Built for daily triage.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 mt-4 text-[10px] uppercase font-display">
            <span class="px-2 py-0.5 border border-white/20">Go</span>
          </div>
        </article>

        <article
          class="sm:col-span-4 lg:col-span-3 p-6 lg:p-8 border border-white/20 bg-black transition-colors duration-200 hover:border-orange/60 focus-within:border-orange/60 flex flex-col justify-between"
        >
          <div>
            <a
              href="https://github.com/planetaryescape/opensound"
              target="_blank"
              rel="noopener noreferrer"
              class="text-2xl uppercase font-display hover:text-orange duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange focus-visible:outline-offset-4"
              >opensound</a
            >
            <p class="mt-3 text-sm text-eagle max-w-md">
              Effect-based Spotify Web API SDK with type-safe calls, retries,
              batching, and OpenTelemetry tracing.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 mt-4 text-[10px] uppercase font-display">
            <span class="px-2 py-0.5 border border-white/20">Effect</span>
            <span class="px-2 py-0.5 border border-white/20">TypeScript</span>
          </div>
        </article>

        <article
          class="sm:col-span-2 lg:col-span-3 p-6 border border-white/20 bg-black transition-colors duration-200 hover:border-orange/60 focus-within:border-orange/60 flex flex-col justify-between sm:rotate-[0.3deg]"
        >
          <div>
            <a
              href="https://github.com/planetaryescape/videoshare"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xl uppercase font-display hover:text-orange duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange focus-visible:outline-offset-4"
              >videoshare</a
            >
            <p class="mt-3 text-sm text-eagle">
              Share videos with a clean player link. No login. Effect v4 on
              Cloudflare Workers, HLS via R2.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 mt-4 text-[10px] uppercase font-display">
            <span class="px-2 py-0.5 border border-white/20">Effect</span>
            <span class="px-2 py-0.5 border border-white/20">Cloudflare</span>
          </div>
        </article>

        <article
          class="sm:col-span-2 lg:col-span-3 p-6 border border-white/20 bg-black transition-colors duration-200 hover:border-orange/60 focus-within:border-orange/60 flex flex-col justify-between"
        >
          <div>
            <a
              href="https://github.com/planetaryescape/blah.chat"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xl uppercase font-display hover:text-orange duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange focus-visible:outline-offset-4"
              >blah.chat</a
            >
            <p class="mt-3 text-sm text-eagle">
              All AI models in one chat. Self-hostable open source alternative
              to ChatGPT. AGPL-3.0.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 mt-4 text-[10px] uppercase font-display">
            <span class="px-2 py-0.5 border border-white/20">TypeScript</span>
            <span class="px-2 py-0.5 border border-white/20">LLM</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto border-white/20 border-x max-w-7xl">
      <div class="p-8 text-center">
        <p class="text-eagle">
          More on the
          <a
            href="https://github.com/planetaryescape"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white underline underline-offset-4 hover:text-orange duration-200"
            >planetaryescape GitHub org →</a
          >
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
